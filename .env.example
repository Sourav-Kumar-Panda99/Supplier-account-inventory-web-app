# Copy this file to .env.local and fill in the values. Never commit .env.local.
# With any of these missing, the app runs in demo mode (in-memory fictional data).

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Generate a key with: npm run generate-key
# Format: {"1":"<base64 key>"}
ENCRYPTION_KEYS=
ENCRYPTION_KEY_VERSION=1
